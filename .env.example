# Copia este archivo a ".env" (que NO se sube a git) y cambia los valores.

# ---------------------------------------------------------------------
# RabbitMQ (docker-compose.yml)
# ---------------------------------------------------------------------
RABBITMQ_USER=biblioteca
RABBITMQ_PASSWORD=biblioteca123
RABBITMQ_ERLANG_COOKIE=BIBLIOTECA_CLUSTER_COOKIE

# ---------------------------------------------------------------------
# Puertos de los microservicios (docker-compose.backend.yml)
# ---------------------------------------------------------------------
# API_PORT=8080
# KAFKA_ADMIN_PORT=8081
# RABBIT_ADMIN_PORT=8082

# ---------------------------------------------------------------------
# Variables que lee el backend Spring Boot (opcionales, tienen valor por defecto)
# ---------------------------------------------------------------------
# RABBITMQ_ADDRESSES=localhost:5672,localhost:5673
# RABBITMQ_MANAGEMENT_URL=http://localhost:15672
# CORS_ALLOWED_ORIGINS=http://localhost:4200
# RABBIT_DLQ_LISTENER_ENABLED=true   # true = los mensajes de las DLQ se registran en logs

# --- Kafka (docker-compose.kafka.yml) ---
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092,localhost:9093,localhost:9094
# KAFKA_ENABLED=true            # false = la app no usa Kafka
# KAFKA_TOPIC_PARTITIONS=3
# KAFKA_TOPIC_REPLICAS=3        # con un solo broker usar 1
# KAFKA_TOPIC_RETENTION_MS=604800000     # 7 días (tópicos de negocio)
# KAFKA_TOPIC_CLEANUP_POLICY=delete
# KAFKA_DLT_RETENTION_MS=86400000        # 24 horas (tópicos DLT)
# KAFKA_DLT_CLEANUP_POLICY=delete
# KAFKA_GROUP_NOTIFICACIONES=biblioteca-notificaciones
# KAFKA_GROUP_PRESTAMOS=biblioteca-prestamos
# KAFKA_GROUP_DLT=biblioteca-dlt
# KAFKA_LISTENER_CONCURRENCY=3
# KAFKA_METRICS_POLLING_SECONDS=5    # intervalo de polling de /api/kafka/metrics

# --- Base de datos CLOUD (PostgreSQL) ---
# Activar con SPRING_PROFILES_ACTIVE=cloud. Sin esto la app usa H2 en memoria.
# SPRING_PROFILES_ACTIVE=cloud
# DB_URL=jdbc:postgresql://<host>:5432/<base>?sslmode=require
# DB_USERNAME=<usuario>
# DB_PASSWORD=<contraseña>
# DDL_AUTO=update
